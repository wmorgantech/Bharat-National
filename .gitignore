# ---------------------------------------------------------------
# Root .gitignore - Bharat National Computers
# Applies to admin/, backend/, frontend/ and the repository root.
# Child .gitignore files remain in effect and are additive.
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
jspm_packages/

# Environment variables / secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# Build output
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
*.tsbuildinfo

# Uploaded / runtime generated files
uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage
coverage/
*.lcov
.nyc_output/

# Temporary files
.temp/
.tmp/
tmp/
*.tmp
*.bak
*.orig

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local overrides
*.local

# IDE / editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.project
.classpath
.settings/
.c9/
*.launch
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Python virtual environments (tooling only - never part of the app)
.venv/
venv/
__pycache__/
