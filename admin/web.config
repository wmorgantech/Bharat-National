<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the BNC admin SPA (Vite build output).

  The browser error
      "Expected a JavaScript-or-Wasm module script but the server responded
       with a MIME type of text/html"
  happens when a request for a built asset (for example /assets/index-*.js)
  is caught by the SPA fallback rule and answered with index.html. The rules
  below make that impossible: assets are either served as real files or
  answered with 404, and only application routes ever reach index.html.

  No origin, host or environment-specific URL appears in this file.
-->
<configuration>
  <system.webServer>

    <!--
      Correct media types for the files Vite emits. Entries are removed first
      so this file is safe to deploy onto a server that already defines them
      (a duplicate mapping makes IIS return HTTP 500).
      MIME checking itself is left enabled - nothing here is a wildcard.
    -->
    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <rewrite>
      <rules>

        <!--
          1. The build is produced with Vite `base: '/admin/'`, so index.html
             asks for /admin/assets/... . When the site is served from the
             application root that prefix has no folder behind it. Strip it,
             but only when the stripped path is a real file - so this rule is
             inert when the app genuinely lives under an /admin virtual
             directory.
        -->
        <rule name="Normalise /admin-prefixed asset paths" stopProcessing="true">
          <match url="^admin/(assets/.+)$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}/{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}" />
        </rule>

        <!--
          2. Anything that exists on disk (file or directory) is served as-is
             and never rewritten.
        -->
        <rule name="Serve existing files and directories directly" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!--
          3. A static asset that reached this point does not exist. Answer 404
             rather than falling through to index.html - returning HTML for a
             .js/.css request is the exact cause of the MIME type error.
        -->
        <rule name="Never fall back to index.html for static assets" stopProcessing="true">
          <match url="(?:^|/)assets/|\.(?:js|mjs|css|map|json|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|eot)$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                  statusDescription="Static asset not found" />
        </rule>

        <!--
          4. Everything else is an application route - hand it to the SPA.
        -->
        <rule name="SPA fallback for application routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>

      </rules>
    </rewrite>

    <!-- Let the 404 above reach the browser instead of an IIS error page. -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
