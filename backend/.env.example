# Copy to .env and fill in real values. Never commit the real .env.

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bnc"

# --- Auth (REQUIRED) ---
# The server refuses to start without this. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Refresh-token lifetimes (days). The sliding TTL applies to each individual
# token; the absolute TTL caps the whole rotation chain, so rotating a stolen
# token can never extend a session beyond this ceiling.
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_ABSOLUTE_TTL_DAYS=7

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Reverse proxy ---
# Number of trusted proxy hops in front of this app; 0 (or unset) disables it.
# Rate limiting identifies clients by IP, so this must match your real topology:
#   0            no proxy - client IP is read from the socket (default)
#   1            exactly one proxy/load balancer in front (e.g. nginx, ALB)
#   <subnet>     a trusted subnet, e.g. 10.0.0.0/8
# Leaving this at 0 behind a proxy makes every client share one rate-limit
# bucket. Setting it too permissively lets X-Forwarded-For be spoofed and the
# rate limit bypassed. Only raise it once the hosting topology is known.
TRUST_PROXY=0

# --- Uploads ---
# Public base URL that uploaded images are served from.
UPLOAD_URL=http://localhost:3000/uploads

# --- CORS ---
# Comma-separated list of browser origins allowed to call this API.
# Required in production; falls back to localhost dev ports when unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- API docs ---
# Swagger is on automatically outside production. Set to true to force it on
# in production (not recommended).
SWAGGER_ENABLED=false

# --- Mail (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
