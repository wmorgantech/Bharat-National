# Copy to .env and fill in real values. Never commit the real .env.

# Base URL of the backend API.
VITE_API_URL="http://localhost:3000"

# WhatsApp contact number shown in the storefront UI.
VITE_WHATSAPP_NUMBER=

# No Razorpay key belongs here. Checkout receives the public key ID from the
# backend in the POST /payment/create-order response, so the storefront never
# needs one in its own environment or bundle.
